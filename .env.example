# Preferred hosted provider: install baro-ai, then run baro login once.
# Uses the official Baro credential helper; upstream API keys are unnecessary.
FACTORY_PROVIDER=jigjoy
FACTORY_MODEL=deepseek-flash
FACTORY_REASONING_EFFORT=low
# Optional external provider modes: auto, openai, anthropic, gemini.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional role overrides (otherwise FACTORY_MODEL is used)
# PM_MODEL=
# TECH_LEAD_MODEL=
# IMPLEMENTATION_DEV_MODEL=
# RELIABILITY_DEV_MODEL=
# QA_MODEL=
# REVIEWER_MODEL=
MAX_RETRIES_PER_TICKET=2
MAX_PROVIDER_RETRIES=1
MAX_PLANNING_RETRIES=2
MAX_MODEL_CALLS_PER_TURN=30
# Hosted reasoning and tool arguments share the output budget.
MAX_OUTPUT_TOKENS=32768
MODEL_TIMEOUT_MS=240000
COMMAND_TIMEOUT_MS=30000
RUN_TIMEOUT_MS=900000
# Optional USD per million tokens. Leave unset when prices are unknown.
# INPUT_USD_PER_MILLION=
# OUTPUT_USD_PER_MILLION=
