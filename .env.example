# Choose your provider and model before a live run. No model is preselected.
# API providers: openai, anthropic, gemini. Use only the matching API key below.
# List supported IDs: npm run models
FACTORY_PROVIDER=
FACTORY_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional: auto infers API providers from selected models.
# Optional hosted alternative: FACTORY_PROVIDER=jigjoy, an account-authorized
# FACTORY_MODEL, and baro login. No upstream provider API key is needed there.
# Set reasoning effort only if your selected model supports it.
# FACTORY_REASONING_EFFORT=
# Optional role overrides (otherwise FACTORY_MODEL is used)
# PM_MODEL=
# TECH_LEAD_MODEL=
# IMPLEMENTATION_DEV_MODEL=
# RELIABILITY_DEV_MODEL=
# QA_MODEL=
# REVIEWER_MODEL=
MAX_RETRIES_PER_TICKET=2
MAX_PROVIDER_RETRIES=1
MAX_PLANNING_RETRIES=2
MAX_MODEL_CALLS_PER_TURN=30
# Optional provider/model-specific limits; leave unset to use runtime defaults.
# MAX_OUTPUT_TOKENS=
# MODEL_TIMEOUT_MS=
COMMAND_TIMEOUT_MS=30000
RUN_TIMEOUT_MS=900000
# Optional USD per million tokens. Leave unset when prices are unknown.
# INPUT_USD_PER_MILLION=
# OUTPUT_USD_PER_MILLION=
