{
  "name": "ai-software-company",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An event-driven AI software company built on Mozaik v4",
  "engines": { "node": ">=22" },
  "scripts": {
    "factory": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "smoke": "tsx src/cli.ts specs/examples/sum-cli.md --demo",
    "smoke:recovery": "tsx src/cli.ts specs/examples/sum-cli.md --demo-recovery"
  },
  "dependencies": { "@mozaik-ai/core": "4.2.0", "dotenv": "^18.0.9", "zod": "^4.6.7" },
  "devDependencies": { "@types/node": "^22.19.0", "tsx": "^4.23.15", "typescript": "~5.9.3" },
  "repository": { "type": "git", "url": "https://github.com/AllForJoon/NTP_Novi_Sad_Hackathon_Software_Factory.git" },
  "license": "MIT"
}
